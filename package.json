{
  "name": "type262",
  "version": "0.2.0",
  "description": "Every domain is a wallet. Resolve, verify and publish DNS WALLET (RRTYPE 262) records, and pay domains in SOL or USDC on Solana, or in USDG or ETH on Robinhood Chain.",
  "homepage": "https://type262.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Type262/262.git"
  },
  "bugs": {
    "url": "https://github.com/Type262/262/issues"
  },
  "author": "TYPE/262",
  "type": "module",
  "exports": "./lib/wallet262.js",
  "bin": {
    "type262": "bin/type262.mjs",
    "type262-mcp": "mcp/type262-mcp.mjs"
  },
  "files": [
    "lib",
    "bin",
    "mcp/type262-mcp.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "python -m http.server 5262 --bind 127.0.0.1",
    "test": "node test/wallet262.test.mjs && node test/abi.test.mjs && node test/chain-data.test.mjs && node test/upload.test.mjs && node test/vault.test.mjs && node test/vault-worker.test.mjs && node test/solana-board.test.mjs && node test/mcp.test.mjs",
    "test:contracts": "cd contracts && forge test",
    "test:mcp:fork": "node test/mcp.test.mjs --fork",
    "upload:dev": "node upload/server.mjs",
    "mcp:build": "node mcp/build.mjs"
  },
  "keywords": [
    "dns",
    "wallet",
    "rrtype-262",
    "dns-wallet",
    "dnssec",
    "solana",
    "usdc",
    "solana-pay",
    "spl-token",
    "pump-fun",
    "launchpad",
    "vaults",
    "domain-vault",
    "x402",
    "robinhood-chain",
    "usdg",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "escrow",
    "ens",
    "web3"
  ],
  "license": "MIT",
  "devDependencies": {
    "@ensdomains/dnsprovejs": "^1.0.1",
    "viem": "^2.57.7"
  }
}
